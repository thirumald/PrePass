PORT=3000
# Where state is saved (signing key, incidents, passes, users, audit log).
DATA_FILE=var/rapidpass.json
# First start only: the admin account. If ADMIN_PASSWORD is empty a random one is printed once.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Comma-separated web addresses allowed to call the API from a browser.
CORS_ORIGIN=https://thirumald.github.io
# Optional server-side TomTom key for /api/tomtom/*.
TOMTOM_KEY=
# 0 disables /api/simulate (the demo vehicle). Keep it off in production.
ENABLE_SIMULATE=1
